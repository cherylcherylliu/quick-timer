html, body
  margin: 0
  padding: 0
  width: 100%
  height: 100%
  -webkit-touch-callout: none
  -webkit-user-select: none
  -khtml-user-select: none
  -moz-user-select: moz-none
  -ms-user-select: none
  user-select: none

body
  background: #0b0f17
  color: #f5f7fb
  font-family: 'Noto Sans TC', 'Helvetica Neue', Arial, sans-serif
  display: flex
  align-items: center
  justify-content: center
  padding: 16px
  box-sizing: border-box

.app
  background: #0f1724
  border: 1px solid #19233a
  border-radius: 14px
  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.45)
  width: 100%
  max-width: 840px
  padding: 24px 28px
  display: flex
  flex-direction: column
  gap: 16px

h1
  margin: 0
  font-size: 28px
  font-weight: 700
  letter-spacing: 0.5px

.lead
  margin: 4px 0 12px 0
  color: #a7b4d6

.controls
  display: grid
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr))
  gap: 12px 18px

.form-group
  display: flex
  flex-direction: column
  gap: 6px

.form-control
  background: #0c1320
  border: 1px solid #1f2c46
  color: #f5f7fb
  border-radius: 10px
  padding: 10px 12px
  font-size: 16px

  &:focus
    outline: none
    border-color: #3a6ff7
    box-shadow: 0 0 0 2px rgba(58, 111, 247, 0.25)

.text-muted
  color: #8ca0c8

.time-inputs
  display: flex
  align-items: center
  gap: 8px

.unit
  color: #c3cee8
  font-weight: 600

.status
  display: flex
  justify-content: space-between
  align-items: center
  gap: 12px
  padding: 12px 16px
  background: #0c1320
  border: 1px solid #1f2c46
  border-radius: 12px

.status-text
  display: flex
  flex-direction: column
  gap: 4px

.align-right
  text-align: right

.label-text
  font-size: 13px
  letter-spacing: 0.4px
  color: #8ca0c8

#phase, #cycle-progress
  font-size: 18px
  font-weight: 700

#timer
  width: 100%
  text-align: center
  background: #0b101d
  color: #f5f7fb
  border-radius: 16px
  border: 1px solid #1f2c46
  padding: 24px
  font-weight: 700
  font-family: 'Century Gothic', 'Noto Sans TC', sans-serif
  font-size: 86px
  letter-spacing: 2px

.actions
  display: flex
  gap: 12px
  justify-content: center

.actions .btn
  min-width: 140px
  border-radius: 10px
  font-size: 18px
  padding: 12px 16px
  font-weight: 700

#quote
  margin: 8px 0 0 0
  font-weight: 700
  color: #7ddca3
  text-align: center

.hidden
  display: none

@media (max-width: 640px)
  #timer
    font-size: 64px
    padding: 18px

  .actions .btn
    width: 100%
    justify-content: center

  .status
    flex-direction: column
    align-items: flex-start

  .align-right
    text-align: left
