doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet",type="text/css",href="bootstrap3.min.css")
    link(rel="stylesheet",type="text/css",href="index.css")
    script(type="text/javascript",src="jquery-1.10.2.min.js")
    script(type="text/javascript",src="bootstrap3.min.js")
    script(type="text/javascript",src="index.js")
  body
    .app
      h1 TABATA 計時器
      p.lead 依照組數、準備時間與每組時間自動倒數，陪你完成訓練。
      .controls
        .form-group
          label(for="cycles") 組數 (sets)
          select#cycles.form-control
            - for (var i = 1; i <= 60; i++) {
              option(value=i selected=i === 8)= i
            - }
          small.text-muted 使用下拉選單快速調整組數
        .form-group
          label(for="prepare") 準備時間 (秒)
          select#prepare.form-control
            - for (var i = 0; i <= 60; i++) {
              option(value=i selected=i === 3)= i
            - }
          small.text-muted 例如：3 秒後開始
        .form-group
          label 每組時間
          .time-inputs
            select#minutes.form-control
              - for (var i = 0; i <= 60; i++) {
                option(value=i selected=i === 0)= i
              - }
            span.unit 分
            select#seconds.form-control
              - for (var i = 1; i <= 60; i++) {
                option(value=i selected=i === 20)= i
              - }
            span.unit 秒
          small.text-muted 選擇分鐘與秒數，會以倒數方式提示
      .status
        .status-text
          div.label-text 倒數狀態
          div#phase 待命
        .status-text.align-right
          div.label-text 組別進度
          div#cycle-progress 尚未開始
      #timer 00:20
      .actions
        button#toggle.btn.btn-primary.btn-lg(onclick="toggle()") 開始
        button#reset.btn.btn-default.btn-lg(onclick="resetTimer()") 重設
      p#quote.hidden 加油！你正在成為更好的自己！
